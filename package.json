{
  "name": "mutanex-twin-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "patient-portal"
  ],
  "scripts": {
    "dev": "node patient-portal/build.mjs && tsx watch server/src/index.ts",
    "build": "tsc -p patient-portal/tsconfig.json --noEmit && node patient-portal/build.mjs && tsc -p server/tsconfig.json && node server/build.mjs",
    "start": "node server.ts",
    "lint": "tsc -p patient-portal/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "npm test --workspace=server"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@types/ws": "^8.18.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ws": "^8.23.0"
  }
}
